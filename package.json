{
  "name": "qiji-kanban",
  "version": "1.0.1",
  "description": "骐骥看板 - Windows 桌面看板软件",
  "main": "launcher.html",
  "inject-js-end": "quit-handler.js",
  "node-remote": [
    "http://localhost:*",
    "http://127.0.0.1:*"
  ],
  "window": {
    "title": "骐骥看板 - QijiKanbanSoftware",
    "width": 1280,
    "height": 720,
    "min_width": 960,
    "min_height": 540,
    "icon": "logo_qiji.png"
  },
  "chromium-args": "--disable-background-networking --disable-component-update --disable-sync --disable-default-apps --no-first-run",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:renderer": "webpack --mode production",
    "build": "npm run build:server && npm run build:renderer",
    "start:server": "node dist/server/index.js",
    "start:renderer": "webpack serve --mode development",
    "start": "concurrently \"npm run start:server\" \"npm run start:renderer\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "uuid": "^11.1.1",
    "qs": "6.16.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "antd": "^6.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "express": "^4.22.2",
    "open": "^11.0.0",
    "openai": "^6.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.7",
    "nw": "^0.88.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  }
}
