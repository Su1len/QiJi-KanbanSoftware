  "imageOverrides": [
    {
      "targetComponent": "KanbanBoard",
      "imagePath": "/themes/custom-example/bg-kanban.png",
      "opacity": 0.08,
      "position": "center",
      "size": "cover"
    },
    {
      "targetComponent": "BottomBar",
      "imagePath": "/themes/custom-example/bg-bottom.png",
      "opacity": 0.15,
      "position": "right bottom",
      "size": "auto"
    }
  ]
